<mvc:View
  controllerName="expensetracker.controller.Dashboard"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:f="sap.f"
  xmlns:viz="sap.viz.ui5.controls"
  xmlns:vizData="sap.viz.ui5.data"
  xmlns:vizFeed="sap.viz.ui5.controls.common.feeds"
  displayBlock="true">

  <Page title="Smart Expense Tracker" >

    <headerContent>
      <Button icon="sap-icon://navigation-left-arrow" press="onPrevMonth" />
      <Text text="{mock>/month}" class="sapUiSmallMarginBeginEnd" />
      <Button icon="sap-icon://navigation-right-arrow" press="onNextMonth" />
      <Button text="Add expense" icon="sap-icon://add" type="Emphasized" press="onAddExpense" class="sapUiSmallMarginBegin" />
    </headerContent>

    <content>

      <!-- Summary tiles updated -->
      <f:GridContainer>
        <f:items>
          <GenericTile header="Total food" subheader="This month" class="sapUiTinyMarginEnd">
            <TileContent unit="INR" footer="">
              <NumericContent value="{mock>/totals/food}" withMargin="false" />
            </TileContent>
          </GenericTile>
          <GenericTile header="Total travel" subheader="This month" class="sapUiTinyMarginEnd">
            <TileContent unit="INR" footer="">
              <NumericContent value="{mock>/totals/travel}" withMargin="false" />
            </TileContent>
          </GenericTile>
          <GenericTile header="Total accommodation" subheader="This month" class="sapUiTinyMarginEnd">
            <TileContent unit="INR" footer="">
              <NumericContent value="{mock>/totals/accommodation}" withMargin="false" />
            </TileContent>
          </GenericTile>
          <GenericTile header="Total others" subheader="This month">
            <TileContent unit="INR" footer="">
              <NumericContent value="{mock>/totals/others}" withMargin="false" />
            </TileContent>
          </GenericTile>
        </f:items>
      </f:GridContainer>

      <!-- Stacked column chart -->
      <Panel headerText="Daily total expense (by category)" class="sapUiResponsiveMargin">
        <viz:VizFrame id="expenseChart" uiConfig="{applicationSet:'fiori'}"
          vizType="stacked_column" width="100%" height="360px">
          <viz:dataset>
            <vizData:FlattenedDataset data="{mock>/chartData}">
              <vizData:dimensions>
                <vizData:DimensionDefinition name="Day" value="{mock>day}" />
              </vizData:dimensions>
              <vizData:measures>
                <vizData:MeasureDefinition name="Food" value="{mock>Food}" />
                <vizData:MeasureDefinition name="Travel" value="{mock>Travel}" />
                <vizData:MeasureDefinition name="Accommodation" value="{mock>Accommodation}" />
                <vizData:MeasureDefinition name="Others" value="{mock>Others}" />
              </vizData:measures>
            </vizData:FlattenedDataset>
          </viz:dataset>
          <viz:feeds>
            <vizFeed:FeedItem uid="valueAxis" type="Measure"
              values="Food,Travel,Accommodation,Others" />
            <vizFeed:FeedItem uid="categoryAxis" type="Dimension" values="Day" />
          </viz:feeds>
        </viz:VizFrame>
      </Panel>

      <!-- Budget usage -->
      <Panel headerText="Budget usage" class="sapUiResponsiveMargin">
        <List items="{mock>/budgets}">
          <CustomListItem>
            <VBox class="sapUiSmallMargin">
              <HBox justifyContent="SpaceBetween">
                <Text text="{mock>category}" />
                <ObjectStatus text="{mock>spent} / {mock>limit}" state="{mock>state}" />
              </HBox>
              <ProgressIndicator
                percentValue="{= Math.min(100, Math.round(${mock>spent} / ${mock>limit} * 100)) }"
                displayValue="{= Math.round(${mock>spent} / ${mock>limit} * 100) }%"
                state="{mock>state}"
                class="sapUiTinyMarginTop" />
            </VBox>
          </CustomListItem>
        </List>
      </Panel>

    </content>
  </Page>
</mvc:View>