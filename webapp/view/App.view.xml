<mvc:View
  controllerName="expensetracker.controller.App"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.tnt"
  xmlns:m="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <ToolPage id="toolPage">
    <header>
      <ToolHeader id="_IDGenToolHeader">
        <m:Button id="_IDGenButton" icon="sap-icon://menu2" press="onToggleSideNav" type="Transparent" />
        <m:Title id="_IDGenTitle" text="Smart Expense Tracker" level="H1" class="sapUiTinyMarginBegin" />
        <m:ToolbarSpacer id="_IDGenToolbarSpacer" />
        <m:Avatar id="_IDGenAvatar1" initials="SA" displaySize="XS" />
      </ToolHeader>
    </header>

    <sideContent>
      <SideNavigation id="sideNav" selectedKey="dashboard" itemSelect="onNavItemSelect">
        <NavigationList id="_IDGenNavigationList">
          <NavigationListItem id="_IDGenNavigationListItem" key="dashboard" text="Dashboard" icon="sap-icon://home" />
          <NavigationListItem id="_IDGenNavigationListItem1" key="addExpense" text="Add expense" icon="sap-icon://add" />
          <NavigationListItem id="_IDGenNavigationListItem2" key="budgets" text="Budgets" icon="sap-icon://money-bills" />
          <NavigationListItem id="_IDGenNavigationListItem3" key="history" text="History" icon="sap-icon://history" />
        </NavigationList>
      </SideNavigation>
    </sideContent>

    <mainContents>
      <m:NavContainer id="navContainer" />
    </mainContents>
  </ToolPage>
</mvc:View>